<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <groupId>guanghe.gsite</groupId>
        <artifactId>guanghe</artifactId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>guanghe-server</artifactId>
    <packaging>jar</packaging>
    <url>https://github.com/guangheUlti/gsite</url>

    <name>${project.artifactId}</name>
    <description>
        后端 Server 的主项目，通过引入需要 guanghe-module-xxx 的依赖，
        从而实现提供 RESTful API 给 guanghe-ui-admin、guanghe-ui-user 等前端项目。
        本质上来说，它就是个空壳（容器）！
    </description>

    <dependencies>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-system</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-infra</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-member</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-report</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-bpm</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-pay</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-mp</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-product</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-promotion</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-trade</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-statistics</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-crm</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-erp</artifactId>
            <version>${revision}</version>
        </dependency>
        <!-- AI 模块需要 JDK 17+，当前 JDK 8 分支不支持 -->
        <!--
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-ai</artifactId>
            <version>${revision}</version>
        </dependency>
        -->
        <!-- IoT 需要 TDengine 时序数据库，当前环境不支持 -->
        <!--
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-iot-biz</artifactId>
            <version>${revision}</version>
        </dependency>
        -->
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-mes</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-wms</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-hrm</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-fms</artifactId>
            <version>${revision}</version>
        </dependency>
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-module-im</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- spring boot 配置所需依赖 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- 服务保障相关 -->
        <dependency>
            <groupId>guanghe.gsite</groupId>
            <artifactId>guanghe-spring-boot-starter-protection</artifactId>
        </dependency>

    </dependencies>

    <build>
        <!-- 设置构建的 jar 包名 -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <!-- 打包 -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal> <!-- 将引入的 jar 打入其中 -->
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
