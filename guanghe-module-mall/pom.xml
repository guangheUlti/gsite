<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>guanghe</artifactId>
        <groupId>guanghe.gsite</groupId>
        <version>${revision}</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>guanghe-module-mall</artifactId>
    <packaging>pom</packaging>
    <url>https://github.com/guangheUlti/gsite</url>

    <name>${project.artifactId}</name>

    <description>
        商城大模块，由 product 商品、promotion 营销、trade 交易、statistics 统计等组成
    </description>
    <modules>
        <module>guanghe-module-product</module>
        <module>guanghe-module-promotion</module>
        <module>guanghe-module-trade</module>
        <module>guanghe-module-statistics</module>
        <!--
            特殊：为什么会有 guanghe-module-trade-api 呢？
                guanghe-module-promotion 和 guanghe-module-trade 之间相互循环依赖，所以抽出 guanghe-module-trade-api 模块，这样：
                1. guanghe-module-promotion 依赖 guanghe-module-trade-api
                2. guanghe-module-trade 依赖 guanghe-module-promotion
            从而不存在相互（循环）依赖，即 guanghe-module-trade => guanghe-module-promotion => guanghe-module-trade-api
         -->
        <module>guanghe-module-trade-api</module>
    </modules>

</project>
