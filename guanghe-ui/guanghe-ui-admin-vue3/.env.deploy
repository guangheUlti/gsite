# 部署环境（自包含 Windows 部署包专用，配合 nginx 同源反向代理使用）
# 构建命令：vite build --mode deploy
NODE_ENV=production

VITE_DEV=false

# 请求路径：留空表示与页面同源，由 nginx 将 /admin-api 反向代理到后端 48080
# 这样部署到任意 IP/域名都无需重新打包，也不存在跨域问题
VITE_BASE_URL=''

# 文件上传类型：server - 后端上传， client - 前端直连上传，仅支持 S3 服务
VITE_UPLOAD_TYPE=server

# 接口地址
VITE_API_URL=/admin-api

# 是否删除debugger
VITE_DROP_DEBUGGER=true

# 是否删除console.log
VITE_DROP_CONSOLE=true

# 是否sourcemap
VITE_SOURCEMAP=false

# 是否开启压缩，可以设置为 none, gzip, brotli, gzip,brotli
VITE_COMPRESS=none

# 打包路径
VITE_BASE_PATH=/

# 输出路径
VITE_OUT_DIR=dist-deploy

# 验证码开关：必须与后端 guanghe.captcha.enable 保持一致（此处同为关闭）
VITE_APP_CAPTCHA_ENABLE=false

# 商城H5会员端域名（未启用商城模块时仅作占位）
VITE_MALL_H5_DOMAIN=''

# GoView域名
VITE_GOVIEW_URL=''
